# Python virtual environments and generated bytecode
.venv/
.venv-*/
__pycache__/
*.py[cod]

# Local configuration and logs
.env
.env.*
!.env.example
*.log

# User-provided images and generated artwork
/uploads/*
!/uploads/.gitkeep
/results/*
!/results/.gitkeep

# Pretrained/course model files are not committed; see pretrained-model/README.md
/pretrained-model/*.h5
/pretrained-model/*.mat
!/pretrained-model/.gitkeep

# Test and editor artifacts
.pytest_cache/
.vscode/
.idea/
Thumbs.db
.DS_Store
